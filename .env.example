# ==============================================================================
# Sourcing Agent — Root Environment Configuration Template
# Copy this file to '.env' and populate your real secrets:
#   cp .env.example .env
# ==============================================================================

# Groq LLM API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# SerpAPI Search Key for Google / LinkedIn sourcing (https://serpapi.com)
SERPAPI_API_KEY=your_serpapi_key_here

# Apollo.io API Key for candidate profile enrichment (Optional)
APOLLO_API_KEY=your_apollo_api_key_here

# JWT Secret for cross-service authentication (must match Spring Boot)
JWT_SECRET=your_jwt_secret_here

# Embedding model & enrichment configurations
EMBEDDING_MODEL=all-MiniLM-L6-v2
ENRICHMENT_ENABLED=true
ENRICHMENT_MONTHLY_QUOTA=1000
