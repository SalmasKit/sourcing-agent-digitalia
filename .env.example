# ==============================================================================
# Sourcing Agent — Root Environment Configuration Template
# Copy this file to '.env' and populate your real secrets:
#   cp .env.example .env
# ==============================================================================

# Groq LLM API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# SerpAPI Search Key for Google / LinkedIn sourcing (https://serpapi.com)
SERPAPI_API_KEY=your_serpapi_key_here

# Apollo.io API Key for candidate profile enrichment (Optional)
APOLLO_API_KEY=your_apollo_api_key_here

# JWT Secret for cross-service authentication (must match Spring Boot)
# Generate a secure 256-bit key, e.g.:
#   openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Prometheus scraper Basic Auth (dedicated metrics account, not a JWT)
METRICS_SCRAPER_USERNAME=prometheus
METRICS_SCRAPER_PASSWORD=change_me_to_a_strong_scraper_password

# Embedding model & enrichment configurations
EMBEDDING_MODEL=all-MiniLM-L6-v2
ENRICHMENT_ENABLED=true
ENRICHMENT_MONTHLY_QUOTA=1000

# Email Delivery / SMTP Settings
# Local development uses Mailpit automatically (view at http://localhost:8025)
# For external SMTP (e.g. Gmail/SendGrid/Resend):
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=true
# SPRING_MAIL_FROM=your-email@gmail.com
# APP_FRONTEND_URL=http://localhost:5173
