# ─────────────────────────────────────────────────────────────────
# Targetalent Frontend — environment variable template
# Copy this file to .env and fill in the values before running.
# ─────────────────────────────────────────────────────────────────

# Set to "true" ONLY for offline/demo environments where the Spring
# Boot backend is intentionally absent. When true, auth falls back
# to a local mock session. NEVER set this in a production deployment.
VITE_DEMO_MODE=false

# Internal target for the Vite /agent-api proxy. This value is read
# by vite.config.js at build/serve time and is NEVER sent to the
# browser — the browser only sees the /agent-api relative path.
# In production, configure your reverse-proxy (Spring Boot / nginx)
# to rewrite /agent-api/* to the agent-service instead.
VITE_AGENT_SERVICE_URL=http://localhost:8001
