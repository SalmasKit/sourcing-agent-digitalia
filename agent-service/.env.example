GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

APP_HOST=0.0.0.0
APP_PORT=8001
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://sourcing_user:sourcing_password@localhost:5433/sourcing_db
# SerpAPI — required for candidate searching
SERPAPI_API_KEY=your_serpapi_api_key_here

EMBEDDING_MODEL=all-MiniLM-L6-v2
SPRING_BOOT_URL=http://localhost:8080
# CORS allowed frontend origin. Set to your deployed frontend URL in production.
FRONTEND_ORIGIN=http://localhost:3000

# JWT verification — must be the SAME value as JWT_SECRET in Spring Boot's env.
# In production, generate a cryptographically random 256-bit key and set it in
# both services. Never commit the real secret.
JWT_SECRET=your_jwt_secret_here_same_as_spring_boot

# Profile Enrichment (Apollo.io)
APOLLO_API_KEY=your_apollo_api_key_here
ENRICHMENT_ENABLED=true
ENRICHMENT_MONTHLY_QUOTA=1000


